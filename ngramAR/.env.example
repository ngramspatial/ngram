# Persistent Entity bridge (recommended; generated by `ngram ar setup`)
# NGRAM_AR_ENTITY_BRIDGE_URL=ws://127.0.0.1:7878/
# NGRAM_AR_ENTITY_BRIDGE_TOKEN=

# Inference-only binding (advanced/stateless alternative)
NGRAM_INFERENCE_GATEWAY_BASE_URL=http://127.0.0.1:8765
INFERENCE_GATEWAY_TOKEN=your-token

# Optional fallbacks (bindings / TTS)
# NGRAM_AR_LLM_API_KEY=sk-...
# NGRAM_AR_TTS_API_KEY=sk-...

# Server bind
NGRAM_AR_PORT=3000
NGRAM_AR_HOST=0.0.0.0

# Optional external GPU motion service (for example an ARDY adapter on RunPod)
# NGRAM_AR_MOTION_PROVIDER_URL=https://your-motion-service.example
# NGRAM_AR_MOTION_PROVIDER_TOKEN=
# NGRAM_AR_MOTION_PROVIDER_TIMEOUT_MS=120000
