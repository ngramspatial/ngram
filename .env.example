# Copy to `.env` at repo root (gitignored). The `ngram` CLI loads it from the repo automatically.
# Guided flow: `ngram setup` (hosted/local first; Cloudflare appears only in explicit hybrid mode)
# Variable semantics: comments in this file + configs/default.yaml

# IANA timezone for wall clock in prompts and get_current_time. On Railway / hybrid_railway, defaults
# to America/New_York (US Eastern) when unset. Override for other regions.
# NGRAM_TIMEZONE=

# --- Platforms ---
# Must match `token_env` in `configs/entities/<name>.yaml` when using that platform.
TELEGRAM_TOKEN=
# Telegram users permitted to talk to the bot (comma-separated). Keep real IDs in .env,
# never in tracked entity YAML. Get your ID from /whoami in Telegram.
# NGRAM_TELEGRAM_ALLOWED_USER_IDS=123456789
# Telegram user ids for /privacy (comma-separated). Merged with YAML operator_user_ids. Use on Railway
# when you do not commit ids to canary.example.yaml. Get ids from /whoami in Telegram.
# NGRAM_TELEGRAM_OPERATOR_IDS=123456789
DISCORD_TOKEN=

# --- Deployment / inference (body vs brain) ---
# Uncomment the block that matches your mode. YAML in `configs/default.yaml` can set these instead.

# Local: Ollama (or other OpenAI-compatible URL) on this machine — default stack.
# NGRAM_DEPLOYMENT_MODE=local
# NGRAM_INFERENCE_PROVIDER=local

# Hybrid: brain at home behind a tunnel; body (e.g. worker) on Railway with Postgres.
# NGRAM_DEPLOYMENT_MODE=hybrid_railway
# NGRAM_INFERENCE_PROVIDER=remote_gateway
# NGRAM_INFERENCE_BASE_URL=https://your-tunnel.example.com
# NGRAM_INFERENCE_TIMEOUT=120
# Send Ollama-style options.num_ctx on chat (disable for strict OpenAI-compatible hosts).
# NGRAM_INFERENCE_PASS_NUM_CTX=true

# Hosted brain (OpenAI-compatible): product-style harness tests with frontier models — no home gateway.
# Defaults: base URL is baked in; keys below. Optional: NGRAM_INFERENCE_BASE_URL to override host
# (must be the root before /v1, e.g. https://openrouter.ai/api or https://api.venice.ai/api).
# The web workspace exposes the same list under Settings > Choose the brain.
# NGRAM_INFERENCE_PROVIDER=openai
# OPENAI_API_KEY=
# NGRAM_INFERENCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NGRAM_INFERENCE_PROVIDER=gemini
# GEMINI_API_KEY=
# NGRAM_INFERENCE_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# NGRAM_INFERENCE_PROVIDER=xai
# XAI_API_KEY=
# NGRAM_INFERENCE_PROVIDER=groq
# GROQ_API_KEY=
# NGRAM_INFERENCE_PROVIDER=together
# TOGETHER_API_KEY=
# NGRAM_INFERENCE_PROVIDER=fireworks
# FIREWORKS_API_KEY=
# NGRAM_INFERENCE_PROVIDER=mistral
# MISTRAL_API_KEY=
# NGRAM_INFERENCE_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# NGRAM_INFERENCE_PROVIDER=venice
# VENICE_API_KEY=
# NGRAM_INFERENCE_PROVIDER=custom
# NGRAM_INFERENCE_BASE_URL=https://provider.example/v1
# NGRAM_INFERENCE_API_KEY_ENV=MY_PROVIDER_API_KEY
# MY_PROVIDER_API_KEY=
# Hosted APIs usually need Ollama-only fields off:
# NGRAM_INFERENCE_PASS_NUM_CTX=false
# Exact hosted chat model. This overrides per-Entity cognition model IDs at runtime.
# NGRAM_INFERENCE_MODEL=gpt-5.6-sol
# Exact embedding model used for episodic/semantic memory. It must return the configured
# memory width (768 by default). OpenAI's safe default is text-embedding-3-small.
# NGRAM_EMBEDDING_MODEL=text-embedding-3-small
# Requested/stored memory vector width. ngram defaults to 768; OpenAI and Venice
# receive this as the compatible `dimensions` request field.
# NGRAM_EMBEDDING_DIMENSIONS=768

# Dangerous tools (shell, workspace files): on the Railway worker they run in the container
# (no extra config). If you use hybrid_railway env vars on your home PC but do not run the worker
# there, those tools stay off your laptop unless you set tools.execution.allow_local: true in the
# entity YAML (or point NGRAM_EXECUTION_RPC_URL at a reachable execution host).
# To hard-ban any off-Railway local execution, set:
# NGRAM_EXECUTION_REQUIRE_RAILWAY=true

# Bearer for remote gateway calls — must match `INFERENCE_GATEWAY_TOKEN` on the home gateway process.
# Default harness key name is in configs/default.yaml (`inference.api_key_env`).
NGRAM_INFERENCE_GATEWAY_TOKEN=

# Advanced: env var name that holds the gateway bearer token (default NGRAM_INFERENCE_GATEWAY_TOKEN).
# NGRAM_INFERENCE_API_KEY_ENV=

# Override Ollama URL when not using inference.base_url / remote gateway.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Railway / Postgres (hybrid body on cloud) ---
# For local CLI (`ngram seeds`, `trace`, `recall`), use the **public** URL from the Postgres
# plugin: `railway variable list -s Postgres --json` → DATABASE_PUBLIC_URL (junction.proxy.rlwy.net).
# The worker's DATABASE_URL points at postgres.railway.internal — that only works inside Railway.
# DATABASE_URL=postgresql://postgres:PASSWORD@junction.proxy.rlwy.net:PORT/railway

# --- Object storage for attachments (hybrid) ---
# NGRAM_ATTACHMENTS_BACKEND=object_s3_compat
# NGRAM_S3_ENDPOINT_URL=https://...
# NGRAM_S3_BUCKET=...
# NGRAM_S3_ACCESS_KEY=...
# NGRAM_S3_SECRET_KEY=...

# --- Home inference gateway (runs on home machine only) ---
# Terminate Cloudflare Tunnel (or equivalent) ONLY at this gateway (127.0.0.1:port) — never at a
# broad reverse proxy that also exposes SSH, NAS UI, or other host services.
# Do not terminate the tunnel at a catch-all reverse proxy; point only at this gateway.
INFERENCE_GATEWAY_TOKEN=
# Required before `ngram gateway on` will expose the public tunnel. Create a Cloudflare Access
# self-hosted application plus Service Auth policy for the tunnel hostname. The gateway validates
# the resulting Cf-Access-Jwt-Assertion at the origin; the launcher fails closed if these are absent.
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=
# NGRAM_CF_ACCESS_CLIENT_ID=
# NGRAM_CF_ACCESS_CLIENT_SECRET=
# Manual gateway launches that will sit behind Cloudflare must also set this to 1. The supported
# gateway launcher sets it automatically after validating all four settings above.
# INFERENCE_GATEWAY_REQUIRE_CF_ACCESS=1
# Upstream model server (OpenAI-compatible).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Listen address for the gateway process.
# INFERENCE_GATEWAY_HOST=127.0.0.1
# INFERENCE_GATEWAY_PORT=8010
# INFERENCE_GATEWAY_BACKEND_TIMEOUT=120
# INFERENCE_GATEWAY_MAX_BODY_BYTES=8000000
# Independent origin-side sliding-window limits (Cloudflare WAF limits remain recommended too).
# INFERENCE_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# INFERENCE_GATEWAY_RATE_LIMIT_UNAUTHENTICATED=10
# INFERENCE_GATEWAY_RATE_LIMIT_AUTHENTICATED=90
# INFERENCE_GATEWAY_RATE_LIMIT_GLOBAL=180

# --- Optional tools ---
# Firecrawl: preferred for search_web / fetch_url when harness enables it; else ddgs / aiohttp.
FIRECRAWL_API_KEY=
# FAL_API_KEY=
# Optional remote "hands" host for shell/write_file (see README). On Railway, leave UNSET unless
# you run that HTTP RPC — a stale URL (e.g. old tunnel) breaks tools until removed; unreachable URLs
# fall back to in-container execution when RAILWAY_ENVIRONMENT is set.
# NGRAM_EXECUTION_RPC_URL=https://hands.example.com
# NGRAM_EXECUTION_RPC_TOKEN=
# Optional: pin the execution workspace root. On Railway hybrid, use the persistent volume:
# NGRAM_EXECUTION_WORKSPACE_DIR=/app/data

# The worker entrypoint creates $WORKSPACE/.venv (ngram[railway,api,full]), .home, and caches there.
# NGRAM_SKIP_VOLUME_VENV=1   # use image Python only (debug; extras not on volume)

# --- ngram AR (Mode B — same Entity in WebXR as Telegram/CLI) ---
# When set, `ngram run` / worker starts a WebSocket bridge for ngramAR shells with
# binding.type: ngram_entity. Point ngramAR/shells/<shell>/.env NGRAM_AR_ENTITY_BRIDGE_URL here.
# NGRAM_AR_ENTITY_BRIDGE_PORT=7878
# NGRAM_AR_ENTITY_BRIDGE_HOST=127.0.0.1
# Optional locally; required for a public bridge. ngram AR sends it as an Authorization: Bearer header.
# NGRAM_AR_ENTITY_BRIDGE_TOKEN=
# Pair AR with the same human relationship used on another surface. For Telegram, send /whoami.
# NGRAM_AR_PERSON_ID=
# NGRAM_AR_PERSON_NAME=You
# Guided local or Railway setup: `ngram ar setup <entity>`
# One-command hosted Quest lab (trusted LAN, no tunnel): `ngram lab up <entity> --lan`
# NGRAM_AR_HOST=127.0.0.1
# NGRAM_AR_PORT=3000
# Random bearer used to bootstrap a secure HttpOnly browser session when the surface is on LAN.
# Generated by `ngram lab setup`; do not commit or share it.
# NGRAM_AR_SURFACE_TOKEN=

# --- Railway / API (see env-vars.md) ---
# NGRAM_ENTITY=canary
# NGRAM_RAILWAY_ROLE=worker
# PORT=8080
